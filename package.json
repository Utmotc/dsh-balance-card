{
  "name": "@utmotc/dsh-balance-card",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "自包含的 DSH 余额/额度侧边栏卡片：跟随当前会话模型背后的厂商，显示余额、百分比与窗口；内置方格 / 圆环 / 线条 / 渐变四种视觉风格，三页设置（卡片样式 / 厂商监控 / 其他工具），21 家厂商直连（API Key、控制台 Cookie、OAuth Token、AK/SK 与自定义 HTTPS），凭据只进 DSH 凭据库，不依赖任何其他插件。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "test",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "LICENSE-dsh-model-balance"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "./assets/icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "balance",
    "quota",
    "billing",
    "sidebar",
    "deepseek",
    "stepfun",
    "kimi",
    "moonshot",
    "openrouter",
    "minimax",
    "xai",
    "siliconflow",
    "baidu",
    "qianfan",
    "baidu-qianfan",
    "token-plan",
    "scnet",
    "mimo",
    "zhipu",
    "zai",
    "volcengine",
    "claude",
    "codex",
    "antigravity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Utmotc/dsh-balance-card.git"
  },
  "bugs": {
    "url": "https://github.com/Utmotc/dsh-balance-card/issues"
  },
  "homepage": "https://github.com/Utmotc/dsh-balance-card#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}